#!/bin/python3

import sys
import check
import hel
import arp


if len(sys.argv) > 1 and (sys.argv[1] == "-a" or sys.argv[1] == "--arp"):
	if len(sys.argv) == 3 or len(sys.argv) == 4:
		check.check_root()
		arp.arp_scan(sys.argv[2], sys.argv[3] if len(sys.argv) == 4 else '')
	else:
		print('\n\033[31m[x]\033[0m You must specify the \033[33m<interface>\033[0m')
		print('\033[31mExample:\033[0m \033[32msudo scanoport -a \033[1;32meth0\033[0m [NETWORK]')
elif len(sys.argv) == 2 or len(sys.argv) == 3:
	if sys.argv[1] == "-h" or sys.argv[1] == "--h" or sys.argv[1] == "-help" or sys.argv[1] == "--help":
		hel.help()
	else:
		target = sys.argv[1]
		port = sys.argv[2] if len(sys.argv) == 3 else ''
		check.check_root()
		check.start(target,port)
else:
	print('\n\033[31mInvaild:\033[0m \033[33m<argument>\033[0m')
	print('\033[31mExample:\033[0m \033[32mpython3 scanoport \033[1;32m192.168.1.0\033[0m OR \033[1;32mgoogle.com\033[0m <PORT>')
